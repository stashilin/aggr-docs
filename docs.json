{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Агрегатор — приём депозитов",
  "colors": {
    "primary": "#2558D0",
    "light": "#4C85E6",
    "dark": "#2558D0"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Документация",
        "groups": [
          {
            "group": "Начало",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Путь заявки",
            "pages": [
              "scenarios-payment",
              "scenarios-exceptions"
            ]
          },
          {
            "group": "Как устроена заявка",
            "pages": [
              "status-stage",
              "amounts",
              "reglament"
            ]
          },
          {
            "group": "Что происходит дальше",
            "pages": [
              "reversal",
              "callbacks",
              "failures"
            ]
          },
          {
            "group": "Попробовать",
            "pages": [
              "sandbox"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Начало",
            "pages": [
              "api-reference/index"
            ]
          },
          {
            "group": "Операции",
            "expanded": true,
            "pages": [
              "api-reference/operations/create-deposit",
              "api-reference/operations/status",
              "api-reference/operations/cancel"
            ]
          },
          {
            "group": "Протокол",
            "pages": [
              "api-reference/authentication",
              "api-reference/conventions"
            ]
          },
          {
            "group": "Песочница",
            "pages": [
              "api-reference/sandbox-reference"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "simple"
    }
  },
  "redirects": [
    {
      "source": "/api-reference/депозиты/создать-депозит",
      "destination": "/api-reference/operations/create-deposit",
      "permanent": true
    },
    {
      "source": "/api-reference/депозиты/статус-депозита",
      "destination": "/api-reference/operations/status",
      "permanent": true
    },
    {
      "source": "/api-reference/депозиты/отменить-депозит",
      "destination": "/api-reference/operations/cancel",
      "permanent": true
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Песочница",
        "href": "https://swbw.mintlify.app/sandbox"
      }
    ]
  }
}
